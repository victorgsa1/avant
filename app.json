{
  "expo": {
    "name": "avant",
    "slug": "avant",
    "scheme": "avant",
    "version": "0.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.avant.app",
      "userInterfaceStyle": "automatic"
    },
    "android": {
      "package": "com.avant.app",
      "userInterfaceStyle": "automatic",
      "adaptiveIcon": {
        "backgroundColor": "#EFECE6",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "experiments": {
      "typedRoutes": true
    },
    "plugins": [
      "expo-router",
      "expo-splash-screen",
      "expo-font",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": false
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "O Avant usa o microfone para você responder falando.",
          "speechRecognitionPermission": "O Avant transcreve sua fala em texto para preencher suas respostas."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "O Avant usa a câmera para você comprovar a ação principal do dia com uma foto.",
          "photosPermission": false,
          "microphonePermission": "O Avant usa o microfone para você responder falando."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O Avant registra onde a ação principal aconteceu, só para validar a conclusão."
        }
      ]
    ]
  }
}
